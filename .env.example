# Copie para .env (docker compose) ou cole no Coolify > Environment Variables. NUNCA faça commit do .env.
# Credenciais ficam só aqui: o código e o config.yaml nunca as contêm.

# ---- Obrigatório --------------------------------------------------------------------------
# Senha do PostgreSQL. Use só letras e números (vai dentro de uma URL):  openssl rand -hex 24
POSTGRES_PASSWORD=

# Painel: usuário, hash da senha e segredo da sessão.
ADMIN_USER=
# Gere com:  printf '%s' 'sua-senha-com-12-ou-mais-caracteres' | npm --prefix web run --silent hash-password
ADMIN_PASSWORD_HASH=
# 32+ caracteres aleatórios:  openssl rand -base64 48
SESSION_SECRET=
# true atrás de HTTPS (Coolify). Use false só para testar em http://localhost.
COOKIE_SECURE=true

# ---- Coleta respeitosa ------------------------------------------------------------------------
# E-mail ou URL de contato enviado no User-Agent, para os sites poderem falar com você.
RADAR_CONTACT=

# ---- IA (sem as chaves o radar guarda os documentos e espera: status pending_llm) -----------
# O modelo NÃO tem padrão: escolha o modelo de cada provedor.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
# Opcional: o config.yaml traz um modelo padrão para a auditoria.
ANTHROPIC_MODEL=

# ---- Alertas (configure ao menos um canal; sem credenciais os alertas ficam "pending") ------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---- Opcional -------------------------------------------------------------------------------
LOG_LEVEL=INFO
WEB_PORT=3000
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
